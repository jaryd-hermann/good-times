# Supabase Configuration
# Get these from: Supabase Dashboard > Settings > API

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Client-side (Expo): add to .env for local dev and as EAS project secrets for production builds.
# Used for Whisper speech-to-text in the entry composer and comments.
EXPO_PUBLIC_OPENAI_API_KEY=

# OneSignal push (App ID from Dashboard → Settings → Keys & IDs).
# Local: add to .env / .env.local. EAS: `eas env:create --name EXPO_PUBLIC_ONESIGNAL_APP_ID --value '<app-id>' --type string --environment production --environment preview --environment development --scope project`
EXPO_PUBLIC_ONESIGNAL_APP_ID=

# iOS APNs entitlement for the OneSignal config plugin (development vs production).
# eas.json sets this per build profile; override locally only if needed.
# ONESIGNAL_APS_MODE=development
