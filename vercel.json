{
  "rewrites": [
    {
      "source": "/join/:path*",
      "destination": "/api/proxy-join/:path*"
    },
    {
      "source": "/share/:path*",
      "destination": "/api/proxy-share/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "https://www.thegoodtimes.app",
      "permanent": true
    }
  ]
}

