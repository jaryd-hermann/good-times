# Copy to admin/.env.local and fill in. These are the same values you set in the
# Vercel project settings for the hosted deployment.

# --- Data layer (SERVER-ONLY) ---
# The service role key must never be exposed to a browser bundle; lib/db.ts is
# marked "server-only" so importing it from a client component fails the build.
SUPABASE_URL=https://ytnnsykbgohiscfgomfe.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Auth (login) ---
# Anon key is used only for the cookie-bound login session (middleware + login).
SUPABASE_ANON_KEY=

# Comma-separated allowlist of emails permitted to sign in. Anyone not listed is
# rejected at login AND on every request. Leave empty and NOBODY can get in.
ADMIN_ALLOWED_EMAILS=you@example.com,teammate@example.com
